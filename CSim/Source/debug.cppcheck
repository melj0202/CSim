<?xml version="1.0" encoding="UTF-8"?>
<project version="1">
    <builddir>debug-cppcheck-build-dir</builddir>
    <analyze-all-vs-configs>false</analyze-all-vs-configs>
    <check-headers>true</check-headers>
    <check-unused-templates>true</check-unused-templates>
    <inline-suppression>true</inline-suppression>
    <max-ctu-depth>2</max-ctu-depth>
    <max-template-recursion>100</max-template-recursion>
    <includedir>
        <dir name="../thirdparty/freetype-2.13.3/"/>
        <dir name="../thirdparty/glew-2.1.0/"/>
        <dir name="../thirdparty/glfw-3.4/"/>
        <dir name="../thirdparty/glm/"/>
        <dir name="../thirdparty/jpeg-9f/"/>
        <dir name="../thirdparty/json/"/>
        <dir name="../thirdparty/libpng-1.6.44/"/>
        <dir name="../thirdparty/stb/"/>
        <dir name="../thirdparty/tracy-0.13.1/"/>
    </includedir>
    <paths>
        <dir name="AssetLoaders"/>
        <dir name="Core"/>
        <dir name="Init"/>
        <dir name="Platform"/>
        <dir name="Rendering"/>
        <dir name="Rulesets"/>
        <dir name="System"/>
        <dir name="Tests"/>
        <dir name="Util"/>
    </paths>
    <check-level-normal/>
    <project-name>debug</project-name>
</project>
